{
  "expo": {
    "name": "TorreSegura",
    "slug": "TorreSegura",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pablopacheco.TorreSegura",
      "infoPlist": {
        "NSCameraUsageDescription": "Esta aplicación necesita acceso a la cámara para escanear códigos QR de los visitantes.",
        "NSMicrophoneUsageDescription": "TorreSegura usa el micrófono para enviar mensajes de voz al asistente."
      }
    },
    "android": {
      "package": "com.pablopacheco.TorreSegura",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite que TorreSegura acceda a tus fotos para adjuntar evidencia a una incidencia."
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "TorreSegura usa el micrófono para enviar mensajes de voz al asistente.",
          "recordAudioAndroid": true
        }
      ],
      "expo-asset"
    ]
  }
}
